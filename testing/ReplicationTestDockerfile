FROM postgres:16

ENV POSTGRES_PASSWORD=password
ENV POSTGRES_USER=postgres

# Install Rust
RUN apt-get update && \
    apt-get install -y curl sudo git build-essential clang libclang-dev && \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain none
ENV PATH="/root/.cargo/bin:${PATH}"

# Install bats
RUN git clone https://github.com/bats-core/bats-core.git
WORKDIR bats-core
RUN ./install.sh $HOME
ENV PATH="/root/bin/:${PATH}"

# Doltgres source
WORKDIR /root/building
COPY ./ ./doltgresql

# Build the doltgres binary, which we will need for bats, and put it on PATH
WORKDIR /root/building/doltgresql
RUN rustup toolchain install && cargo build --profile quick -p server && cargo test --profile quick -p server --test replication --no-run
RUN cp target/quick/doltgres /root/bin

WORKDIR /root/building/doltgresql/

# This env var is required to run the bats replication tests
ENV RUN_DOLTGRES_REPLICATION_TESTS=true
# This should be set in the github env, but set it here for local testing as well
ENV GITHUB_ACTION=true

# Run the test script, which starts postgres and then runs the replication tests
ENTRYPOINT ["testing/replication-test-entrypoint.sh"]

