{"databases":1,"name":"d_large_int_pk_diff","steps":[{"admin":"CREATE DATABASE \"@db0@\"","divergence":null,"error":false},{"continue":true,"database":"@db0@","statements":[{"dolt":"CREATE TABLE t(pk BIGINT PRIMARY KEY, v TEXT)","expect":{"ok":true},"sql":"CREATE TABLE t(pk bigint PRIMARY KEY, v TEXT)"},{"expect":{"ok":true},"sql":"INSERT INTO t VALUES(4294967296,'a'),(8589934592,'b'),(17179869184,'c')"},{"dolt":"CALL dolt_add('-A')","expect":{"columns":["status"],"rows":[["0"]]},"sql":"SELECT * FROM dolt_add('-A')"},{"dolt":"CALL dolt_commit('-m','seed')","expect":{"columns":["hash"],"rows":[["@hash0@"]]},"sql":"SELECT * FROM dolt_commit('-m','seed')"},{"expect":{"ok":true},"sql":"UPDATE t SET v='B' WHERE pk=8589934592"},{"expect":{"ok":true},"sql":"DELETE FROM t WHERE pk=4294967296"},{"expect":{"ok":true},"sql":"INSERT INTO t VALUES(34359738368,'d')"},{"dolt":"CALL dolt_add('-A')","expect":{"columns":["status"],"rows":[["0"]]},"sql":"SELECT * FROM dolt_add('-A')"},{"dolt":"CALL dolt_commit('-m','c2')","expect":{"columns":["hash"],"rows":[["@hash1@"]]},"sql":"SELECT * FROM dolt_commit('-m','c2')"},{"dolt":"SELECT CONCAT('R|',IFNULL(to_pk,''),'|',IFNULL(to_v,''),'|',IFNULL(from_pk,''),'|',IFNULL(from_v,''),'|',diff_type)\n   FROM dolt_diff('HEAD~1','HEAD', \"t\") ORDER BY diff_type, IFNULL(to_pk,from_pk)","expect":{"columns":["concat"],"rows":[["R|34359738368|d|||added"],["R|8589934592|B|8589934592|b|modified"],["R|||4294967296|a|removed"]]},"sql":"SELECT CONCAT('R|',coalesce((to_pk)::text, ('')::text),'|',coalesce((to_v)::text, ('')::text),'|',coalesce((from_pk)::text, ('')::text),'|',coalesce((from_v)::text, ('')::text),'|',diff_type)\n   FROM dolt_diff('HEAD~1','HEAD', 't') ORDER BY diff_type, coalesce(to_pk, from_pk)"}]}]}
